generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TaskMode {
  NORMAL
  PROOF
}

enum Frequency {
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM
}

enum CheckInStatus {
  DONE
  VERIFIED
}

enum Verdict {
  PASS
  FAIL
}

model Profile {
  userId    String   @id
  timezone  String   @default("UTC")
  createdAt DateTime @default(now())

  tasks Task[]
}

model Task {
  id           String    @id @default(cuid())
  userId       String
  title        String
  description  String?
  doneCriteria String?
  mode         TaskMode
  frequency    Frequency @default(DAILY)
  intervalDays Int?
  color        String    @default("#6366f1")
  emoji        String?
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())

  profile        Profile         @relation(fields: [userId], references: [userId])
  checkIns       CheckIn[]
  verifyAttempts VerifyAttempt[]

  @@index([userId])
}

model CheckIn {
  id        String        @id @default(cuid())
  taskId    String
  userId    String
  date      DateTime      @db.Date
  status    CheckInStatus
  createdAt DateTime      @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, date])
  @@index([userId])
}

model VerifyAttempt {
  id         String   @id @default(cuid())
  taskId     String
  userId     String
  date       DateTime @db.Date
  verdict    Verdict
  confidence Float
  reason     String
  provider   String
  createdAt  DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, date])
}
